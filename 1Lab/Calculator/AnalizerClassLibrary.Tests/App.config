<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Рядок підключення до бази даних з набором тестових даних.
      Розгортання БД: Database\Deploy-TestDatabase.ps1

      Якщо використовується інший екземпляр MS SQL Server, замініть Data Source,
      наприклад:  Data Source=.\SQLEXPRESS  або  Data Source=localhost
      Рядок підключення також можна перевизначити змінною середовища
      CALC_TESTDB_CONNECTION (має вищий пріоритет).
    -->
    <add name="CalcTestDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CalcTestDb;Integrated Security=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
