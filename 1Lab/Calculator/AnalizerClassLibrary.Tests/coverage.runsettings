<?xml version="1.0" encoding="utf-8"?>
<!-- vstest.console.exe <test.dll> /Settings:coverage.runsettings /Collect:"XPlat Code Coverage" -->
<RunSettings>

  <RunConfiguration>
    <TargetFrameworkVersion>net472</TargetFrameworkVersion>
    <MaxCpuCount>1</MaxCpuCount>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[AnalizerClassLibrary]*,[ErrorLibrary]*</Include>
          <Exclude>[AnalizerClassLibrary.Tests]*</Exclude>
          <ExcludeByAttribute>CompilerGeneratedAttribute</ExcludeByAttribute>
          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

</RunSettings>
